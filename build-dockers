#!/usr/bin/env bash

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SSH_BACKUP="${HOME}/ssh-backup.tar.gz"
SSH_DIR="${SCRIPT_DIR}/.ssh"

if [ -f "${SSH_BACKUP}" ]; then
  echo "Extracting SSH keys from ${SSH_BACKUP}..."
  mkdir -p "${SSH_DIR}"
  tar -xzf "${SSH_BACKUP}" --strip-components=3 -C "${SSH_DIR}"
  chmod 700 "${SSH_DIR}"
  chmod 600 "${SSH_DIR}"/id_rsa 2>/dev/null || true
  chmod 644 "${SSH_DIR}"/id_rsa.pub 2>/dev/null || true
  chmod 600 "${SSH_DIR}"/id_ed25519 2>/dev/null || true
  chmod 644 "${SSH_DIR}"/id_ed25519.pub 2>/dev/null || true
else
  echo "Warning: ${SSH_BACKUP} not found — building without SSH keys."
fi

docker build . -t new-computer
